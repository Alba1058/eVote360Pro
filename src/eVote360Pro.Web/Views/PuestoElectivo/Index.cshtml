@model List<eVote360Pro.Core.Application.ViewModels.Puestos.PuestoElectivoViewModel>

@{
    ViewData["Title"] = "Puestos Electivos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Mantenimiento de Puestos Electivos</h2>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Crear
            </a>
        }
    </div>

    @if ((bool)ViewBag.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar puestos electivos mientras exista una elección activa.
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre del Puesto</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var puesto in Model)
                {
                    <tr>
                        <td>@puesto.Nombre</td>
                        <td>@puesto.Descripcion</td>
                        <td>
                            @if (puesto.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (!(bool)ViewBag.HayEleccionActiva)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Edit" asp-route-id="@puesto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    @if (puesto.IsActive)
                                    {
                                        <a asp-action="Deactivate" asp-route-id="@puesto.Id" class="btn btn-sm btn-outline-warning">Desactivar</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Activate" asp-route-id="@puesto.Id" class="btn btn-sm btn-outline-success">Activar</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No hay puestos electivos registrados.
        </div>
    }
</div>
