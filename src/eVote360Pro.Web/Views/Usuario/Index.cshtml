@model List<eVote360Pro.Core.Application.ViewModels.Usuarios.UsuarioViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Mantenimiento de Usuarios</h2>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Crear
            </a>
        }
    </div>

    @if ((bool)ViewBag.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar usuarios mientras exista una elección activa.
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Correo Electrónico</th>
                    <th>Nombre de Usuario</th>
                    <th>Rol</th>
                    <th>Partido Político</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Apellido</td>
                        <td>@usuario.CorreoElectronico</td>
                        <td>@usuario.NombreUsuario</td>
                        <td>
                            @if (usuario.Rol == eVote360Pro.Core.Domain.Enums.RolUsuario.Administrador)
                            {
                                <span class="badge bg-primary">Administrador</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Dirigente Político</span>
                            }
                        </td>
                        <td>
                            @if (usuario.PartidoPoliticoId.HasValue)
                            {
                                <span>@usuario.PartidoPoliticoNombre</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin asignar</span>
                            }
                        </td>
                        <td>
                            @if (usuario.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (!(bool)ViewBag.HayEleccionActiva)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    @if (usuario.IsActive)
                                    {
                                        <a asp-action="Deactivate" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-warning">Desactivar</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Activate" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-success">Activar</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No hay usuarios registrados.
        </div>
    }
</div>
