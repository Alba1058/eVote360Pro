@model List<UsuarioDirigenteViewModel>

@{
    ViewData["Title"] = "Asignación de Dirigentes";
}

<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Asignación de Dirigentes Políticos</h4>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="CreateAsignacion" class="btn btn-light btn-sm">Agregar asignación</a>
        }
    </div>
    <div class="card-body">
        @if ((bool)ViewBag.HayEleccionActiva)
        {
            <div class="alert alert-warning">No se pueden modificar asignaciones de dirigentes políticos mientras exista una elección activa.</div>
        }

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre del dirigente político</th>
                            <th>Nombre de usuario</th>
                            <th>Partido político asignado</th>
                            <th>Siglas del partido</th>
                            <th>Estado del dirigente</th>
                            <th>Estado del partido</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NombreCompleto</td>
                                <td>@item.NombreUsuario</td>
                                <td>@item.PartidoNombre</td>
                                <td>@item.PartidoSiglas</td>
                                <td>@(item.IsActive ? "Activo" : "Inactivo")</td>
                                <td>@(item.PartidoActivo ? "Activo" : "Inactivo")</td>
                                <td>
                                    @if (!(bool)ViewBag.HayEleccionActiva)
                                    {
                                        <a asp-action="EliminarAsignacion" asp-route-id="@item.UsuarioId" class="btn btn-outline-danger btn-sm">Eliminar relación</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No disponible</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No hay asignaciones registradas.</div>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Index" asp-controller="Usuario" class="btn btn-secondary">Volver a Usuarios</a>
    </div>
</div>
