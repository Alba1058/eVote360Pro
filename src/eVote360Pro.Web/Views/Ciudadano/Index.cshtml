@model List<eVote360Pro.Core.Application.ViewModels.Ciudadania.CiudadanoViewModel>

@{
    ViewData["Title"] = "Ciudadanos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Mantenimiento de Ciudadanos</h2>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Crear
            </a>
        }
    </div>

    @if ((bool)ViewBag.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar ciudadanos mientras exista una elección activa.
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Correo Electrónico</th>
                    <th>Número de Documento</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ciudadano in Model)
                {
                    <tr>
                        <td>@ciudadano.Nombre</td>
                        <td>@ciudadano.Apellido</td>
                        <td>@ciudadano.CorreoElectronico</td>
                        <td><strong>@ciudadano.NumeroDocumento</strong></td>
                        <td>
                            @if (ciudadano.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (!(bool)ViewBag.HayEleccionActiva)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Edit" asp-route-id="@ciudadano.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    @if (ciudadano.IsActive)
                                    {
                                        <a asp-action="Deactivate" asp-route-id="@ciudadano.Id" class="btn btn-sm btn-outline-warning">Desactivar</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Activate" asp-route-id="@ciudadano.Id" class="btn btn-sm btn-outline-success">Activar</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay ciudadanos registrados.
        </div>
    }
</div>
