@model ResultadosEleccionViewModel

@{
    ViewData["Title"] = "Resultados de Elección";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Resultados: @Model.EleccionNombre</h4>
                <small>Fecha: @Model.Fecha.ToString("dd/MM/yyyy")</small>
            </div>
            <div class="card-body">
                @foreach (var puesto in Model.Puestos)
                {
                    <h5 class="mt-3">@puesto.PuestoNombre</h5>
                    @if (puesto.ExisteEmpate)
                    {
                        <div class="alert alert-warning">Existe un empate en el primer lugar para este puesto electivo.</div>
                    }
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Candidato / opción</th>
                                    <th>Partido</th>
                                    <th>Votos</th>
                                    <th>Porcentaje</th>
                                    <th>Resultado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opcion in puesto.Opciones)
                                {
                                    <tr class="@(opcion.EsGanador && !puesto.ExisteEmpate ? "table-success" : "")">
                                        <td>@opcion.CandidatoNombre</td>
                                        <td>@opcion.PartidoNombre</td>
                                        <td>@opcion.CantidadVotos</td>
                                        <td>@opcion.Porcentaje.ToString("0.##")%</td>
                                        <td>
                                            @if (opcion.EsGanador && !puesto.ExisteEmpate)
                                            {
                                                <span class="badge bg-success">Ganador</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <a asp-action="Index" class="btn btn-secondary mt-3">Volver atrás</a>
            </div>
        </div>
    </div>
</div>
