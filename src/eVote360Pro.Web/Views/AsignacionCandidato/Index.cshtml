@model List<eVote360Pro.Core.Application.ViewModels.Partidos.AsignacionCandidatoPuestoViewModel>
@using eVote360Pro.Core.Domain.Enums

@{
    ViewData["Title"] = "Asignación de Candidatos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Asignación de Candidatos a Puestos</h2>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Agregar asignación
            </a>
        }
    </div>

    @if ((bool)ViewBag.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar asignaciones de candidatos a puestos mientras exista una elección activa.
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre del candidato</th>
                    <th>Apellido del candidato</th>
                    <th>Partido de origen del candidato</th>
                    <th>Puesto electivo asociado</th>
                    <th>Tipo de candidatura</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asignacion in Model)
                {
                    <tr>
                        <td>@asignacion.CandidatoNombre</td>
                        <td>@asignacion.CandidatoApellido</td>
                        <td>@asignacion.PartidoOrigenNombre</td>
                        <td>@asignacion.PuestoElectivoNombre</td>
                        <td>
                            @if (asignacion.TipoCandidatura == TipoCandidatura.Propio)
                            {
                                <span class="badge bg-primary">Propio</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Aliado</span>
                            }
                        </td>
                        <td>
                            @if (!(bool)ViewBag.HayEleccionActiva)
                            {
                                <a asp-action="Delete" asp-route-id="@asignacion.Id" class="btn btn-sm btn-danger">Eliminar relación</a>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay asignaciones de candidatos registradas.
        </div>
    }
</div>
