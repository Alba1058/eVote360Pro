@model List<eVote360Pro.Core.Application.ViewModels.Partidos.CandidatoViewModel>

@{
    ViewData["Title"] = "Candidatos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Mantenimiento de Candidatos</h2>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Crear
            </a>
        }
    </div>

    @if ((bool)ViewBag.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar candidatos mientras exista una elección activa.
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Foto del candidato</th>
                    <th>Puesto electivo asociado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidato in Model)
                {
                    <tr>
                        <td>@candidato.Nombre</td>
                        <td>@candidato.Apellido</td>
                        <td>
                            @if (!string.IsNullOrEmpty(candidato.Foto))
                            {
                                <img src="@candidato.Foto" style="max-height: 50px; max-width: 50px;" alt="@candidato.Nombre @candidato.Apellido" />
                            }
                            else
                            {
                                <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 50px; width: 50px;">
                                    <i class="bi bi-person text-white"></i>
                                </div>
                            }
                        </td>
                        <td>@candidato.PuestoElectivoNombre</td>
                        <td>
                            @if (candidato.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (!(bool)ViewBag.HayEleccionActiva)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Edit" asp-route-id="@candidato.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    @if (candidato.IsActive)
                                    {
                                        <a asp-action="Deactivate" asp-route-id="@candidato.Id" class="btn btn-sm btn-outline-warning">Desactivar</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Activate" asp-route-id="@candidato.Id" class="btn btn-sm btn-outline-success">Activar</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No hay candidatos registrados.
        </div>
    }
</div>
