@model eVote360Pro.Core.Application.ViewModels.Shared.ConfirmActionViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="confirm-panel">
    <div class="card hero-card">
        <div class="card-body text-center p-4 p-md-5">
            <div class="confirm-icon">
                <i class="bi bi-question-circle-fill"></i>
            </div>
            <h2 class="page-title h4 mb-3">@Model.Title</h2>
            <p class="text-muted mb-4">@Model.Message</p>

            <form asp-controller="@Model.Controller" asp-action="@Model.PostAction" method="post" class="d-flex flex-wrap justify-content-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.EntityId" />
                <button type="submit" class="btn @Model.ConfirmButtonClass px-4">
                    <i class="bi bi-check2-circle"></i> @Model.ConfirmButtonText
                </button>
                <a asp-controller="@Model.Controller" asp-action="@Model.CancelAction" class="btn btn-outline-secondary px-4">
                    @Model.CancelButtonText
                </a>
            </form>
        </div>
    </div>
</div>
