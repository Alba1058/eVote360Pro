@model AlianzasIndexViewModel

@{
    ViewData["Title"] = "Alianzas Políticas";
    int partidoId = (int)ViewBag.PartidoId;
}

<div class="container-fluid py-4">
    @if (Model.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar alianzas políticas mientras exista una elección activa.
        </div>
    }

    <h3 class="mb-3">Solicitudes pendientes de responder</h3>
    @if (Model.SolicitudesPendientes.Any())
    {
        <div class="table-responsive mb-4">
            <table class="table table-striped">
            <thead><tr><th>Partido solicitante</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var s in Model.SolicitudesPendientes)
                {
                    <tr>
                        <td>@s.NombrePartidoSolicitante (@s.SiglasPartidoSolicitante)</td>
                        <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td>En espera de respuesta</td>
                        <td>
                            @if (!Model.HayEleccionActiva)
                            {
                                <a asp-action="Aceptar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-success me-1">Aceptar</a>
                                <a asp-action="Rechazar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Rechazar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-4">No hay solicitudes pendientes de responder.</p>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Solicitudes realizadas</h3>
        @if (!Model.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Crear solicitud
            </a>
        }
    </div>
    @if (Model.SolicitudesEnviadas.Any())
    {
        <div class="table-responsive mb-4">
            <table class="table table-striped">
            <thead><tr><th>Partido destino</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var s in Model.SolicitudesEnviadas)
                {
                    <tr>
                        <td>@s.NombrePartidoReceptor (@s.SiglasPartidoReceptor)</td>
                        <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td>@s.Estado</td>
                        <td>
                            @if (!Model.HayEleccionActiva && (s.Estado == EstadoSolicitudAlianza.EnEsperaDeRespuesta || s.Estado == EstadoSolicitudAlianza.Rechazada))
                            {
                                <a asp-action="EliminarSolicitud" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-4">No ha enviado solicitudes de alianza.</p>
    }

    <h3 class="mb-3">Alianzas vigentes</h3>
    @if (Model.AlianzasVigentes.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped">
            <thead><tr><th>Partido aliado</th><th>Fecha de aceptación</th><th>Acciones</th></tr></thead>
            <tbody>
                @foreach (var a in Model.AlianzasVigentes)
                {
                    var aliado = a.Partido1Id == partidoId
                        ? $"{a.NombrePartido2} ({a.SiglasPartido2})"
                        : $"{a.NombrePartido1} ({a.SiglasPartido1})";
                    <tr>
                        <td>@aliado</td>
                        <td>@a.FechaAceptacion.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (!Model.HayEleccionActiva)
                            {
                                <a asp-action="EliminarAlianza" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Eliminar alianza</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <p class="text-muted">No hay alianzas vigentes.</p>
    }
</div>
