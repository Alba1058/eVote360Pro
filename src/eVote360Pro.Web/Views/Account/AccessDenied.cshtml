@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0 text-center">Acceso Denegado</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: #dc3545;"></i>
                </div>
                <h5 class="mb-3">No posee permisos para acceder a esta sección.</h5>
                <p class="text-muted">Si cree que esto es un error, por favor contacte al administrador del sistema.</p>
                
                <div class="mt-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        if (role == "Administrador")
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-primary">Ir al Home del Administrador</a>
                        }
                        else if (role == "DirigentePolitico")
                        {
                            <a asp-controller="Dirigente" asp-action="Index" class="btn btn-primary">Ir al Home del Dirigente</a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Iniciar Sesión</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
