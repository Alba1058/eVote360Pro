@model List<eVote360Pro.Core.Application.ViewModels.Partidos.PartidoPoliticoViewModel>

@{
    ViewData["Title"] = "Partidos Políticos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Mantenimiento de Partidos Políticos</h2>
        @if (!(bool)ViewBag.HayEleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Crear
            </a>
        }
    </div>

    @if ((bool)ViewBag.HayEleccionActiva)
    {
        <div class="alert alert-warning mb-4">
            No se pueden modificar partidos políticos mientras exista una elección activa.
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Nombre</th>
                    <th>Siglas</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var partido in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(partido.Logo))
                            {
                                <img src="@partido.Logo" class="img-fluid" style="max-height: 50px;" alt="@partido.Siglas" />
                            }
                            else
                            {
                                <span class="text-muted">Sin logo</span>
                            }
                        </td>
                        <td>@partido.Nombre</td>
                        <td>@partido.Siglas</td>
                        <td>@partido.Descripcion</td>
                        <td>
                            @if (partido.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (!(bool)ViewBag.HayEleccionActiva)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Edit" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    @if (partido.IsActive)
                                    {
                                        <a asp-action="Deactivate" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-warning">Desactivar</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Activate" asp-route-id="@partido.Id" class="btn btn-sm btn-outline-success">Activar</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay partidos políticos registrados.
        </div>
    }
</div>
