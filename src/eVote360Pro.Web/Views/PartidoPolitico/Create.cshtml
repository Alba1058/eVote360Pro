@model eVote360Pro.Core.Application.ViewModels.Partidos.SavePartidoPoliticoViewModel

@{
    ViewData["Title"] = "Crear Partido Político";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Crear Partido Político</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre del partido</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Partido Nacional Democrático" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Siglas" class="form-label">Siglas</label>
                        <input asp-for="Siglas" class="form-control" placeholder="Ej: PND" maxlength="10" />
                        <span asp-validation-for="Siglas" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del partido político"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Logo del partido</label>
                        <input type="file" name="logoFile" class="form-control" accept="image/*" required />
                        <small class="text-muted">Formatos: JPG, PNG. Tamaño razonable recomendado.</small>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Activo</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Crear Partido Político</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
