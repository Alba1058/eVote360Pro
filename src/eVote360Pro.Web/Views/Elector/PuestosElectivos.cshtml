@model List<eVote360Pro.Core.Application.ViewModels.Elector.PuestoElectivoVotacionViewModel>

@{
    ViewData["Title"] = "Puestos Electivos";
    ViewData["BodyClass"] = "page-elector";

    var totalPuestos = Model?.Count ?? 0;
    var completados = Model?.Count(p => p.Seleccionado) ?? 0;
    var pendientes = totalPuestos - completados;
}

<div class="process-shell">
    <div class="card process-card">
        <div class="process-header">
            <div class="process-kicker">
                <i class="bi bi-ui-checks-grid"></i>
                Paso 4 de 5
            </div>
            <h1 class="h3">Puestos electivos disponibles</h1>
            <p class="process-subtitle">Seleccione una opción por cada puesto. Puede modificar una selección antes de finalizar la votación.</p>

            <div class="summary-banner">
                <div class="summary-tile">
                    <strong>@totalPuestos</strong>
                    <span>Puestos en esta elección</span>
                </div>
                <div class="summary-tile">
                    <strong>@completados</strong>
                    <span>Selecciones guardadas</span>
                </div>
                <div class="summary-tile">
                    <strong>@pendientes</strong>
                    <span>Puestos pendientes</span>
                </div>
            </div>
        </div>

        <div class="content-section">
            @if (Model != null && Model.Any())
            {
                <div class="positions-grid">
                    @foreach (var puesto in Model)
                    {
                        <div class="position-card">
                            <div class="position-card-header">
                                <div>
                                    <h2 class="position-card-title">@puesto.Nombre</h2>
                                    <div class="helper-text">Seleccione o actualice su preferencia para este puesto.</div>
                                </div>

                                @if (puesto.Seleccionado)
                                {
                                    <span class="status-pill done">
                                        <i class="bi bi-check2-circle me-1"></i> Completado
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill pending">
                                        <i class="bi bi-clock me-1"></i> Pendiente
                                    </span>
                                }
                            </div>

                            <div class="meta-grid">
                                <div class="meta-card">
                                    <span class="meta-label">Partidos</span>
                                    <span class="meta-value">@puesto.CantidadPartidos</span>
                                </div>
                                <div class="meta-card">
                                    <span class="meta-label">Candidatos reales</span>
                                    <span class="meta-value">@puesto.CantidadCandidatos</span>
                                </div>
                            </div>

                            <a asp-action="VotarPuesto" asp-route-puestoId="@puesto.Id" class="btn @(puesto.Seleccionado ? "btn-outline-primary" : "btn-primary") w-100">
                                <i class="bi @(puesto.Seleccionado ? "bi-pencil-square" : "bi-hand-index-thumb")"></i>
                                @(puesto.Seleccionado ? "Modificar selección" : "Seleccionar candidato")
                            </a>
                        </div>
                    }
                </div>

                @if (Model.All(p => p.Seleccionado))
                {
                    <div class="soft-panel mt-4">
                        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                            <div>
                                <h5 class="mb-1">Todo listo para finalizar</h5>
                                <p class="helper-text mb-0">Ya completó su selección para todos los puestos disponibles. Revise y confirme su votación.</p>
                            </div>
                            <a asp-action="FinalizarVotacion" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle-fill"></i> Finalizar votación
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    No hay puestos electivos disponibles para esta elección.
                </div>
            }
        </div>
    </div>
</div>
