@model eVote360Pro.Core.Application.ViewModels.Elector.VotarPuestoViewModel

@{
    ViewData["Title"] = "Votar Puesto";
    ViewData["BodyClass"] = "page-elector";
}

<div class="process-shell">
    <div class="card process-card">
        <div class="process-header">
            <div class="process-kicker">
                <i class="bi bi-person-check"></i>
                Selección por puesto
            </div>
            <h1 class="h3">@Model.PuestoNombre</h1>
            <p class="process-subtitle">Elija un candidato para este puesto o seleccione `Ninguno` si no desea votar por una candidatura específica.</p>
        </div>

        <div class="content-section">
            <form asp-action="VotarPuesto" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="PuestoElectivoId" />
                <input type="hidden" asp-for="PuestoNombre" />

                <div class="vote-options-grid">
                    @foreach (var candidato in Model.Candidatos)
                    {
                        var estaSeleccionado = Model.CandidatoSeleccionadoId == candidato.Id || (candidato.EsNinguno && Model.CandidatoSeleccionadoId == -1);

                        <label class="vote-option @(candidato.EsNinguno ? "none-option" : "")" for="candidato_@candidato.Id">
                            <input type="radio"
                                   asp-for="CandidatoSeleccionadoId"
                                   value="@candidato.Id"
                                   id="candidato_@candidato.Id"
                                   checked="@(estaSeleccionado ? "checked" : null)" />

                            <span class="vote-option-card">
                                @if (candidato.EsNinguno)
                                {
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="candidate-placeholder">
                                            <i class="bi bi-slash-circle"></i>
                                        </div>
                                        <div>
                                            <div class="d-block fw-bold fs-5 text-body">Ninguno</div>
                                            <div class="helper-text">No deseo seleccionar un candidato para este puesto.</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="vote-option-head">
                                        @if (!string.IsNullOrEmpty(candidato.Foto))
                                        {
                                            <img src="@candidato.Foto" class="candidate-photo" alt="@candidato.Nombre @candidato.Apellido" />
                                        }
                                        else
                                        {
                                            <div class="candidate-placeholder">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }

                                        <div class="flex-grow-1">
                                            <div class="d-block fw-bold fs-5 text-body">@candidato.Nombre @candidato.Apellido</div>
                                            <div class="party-badge mt-2">@candidato.PartidoSiglas</div>
                                            <div class="d-block helper-text mt-2">@candidato.PartidoNombre</div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(candidato.PartidoLogo))
                                    {
                                        <div class="d-block mt-3">
                                            <img src="@candidato.PartidoLogo" class="party-logo" alt="@candidato.PartidoSiglas" />
                                        </div>
                                    }
                                }
                            </span>
                        </label>
                    }
                </div>

                <div class="action-bar mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle"></i> Guardar voto del puesto
                    </button>
                    <a asp-action="PuestosElectivos" class="btn btn-outline-primary btn-lg">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
